rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Passenger profile + trusted contacts
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /contacts/{id} {
        allow read, write: if isOwner(uid);
      }
    }

    // Trips: the passenger owns her trips.
    // NOTE: the demo driver simulator writes driver fields from the passenger
    // app. When the real driver app exists, restrict those fields to drivers.
    match /trips/{tripId} {
      allow create: if signedIn() && request.resource.data.passengerId == request.auth.uid;
      allow read, update: if signedIn() && resource.data.passengerId == request.auth.uid;
      match /messages/{m} {
        allow read, create: if signedIn() &&
          get(/databases/$(database)/documents/trips/$(tripId)).data.passengerId == request.auth.uid;
      }
    }

    match /plans/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /sos_alerts/{id} {
      allow create: if signedIn() && request.resource.data.passengerId == request.auth.uid;
      allow read, update: if signedIn() && resource.data.passengerId == request.auth.uid;
    }

    match /tickets/{id} {
      allow create: if signedIn() && request.resource.data.passengerId == request.auth.uid;
      allow read: if signedIn() && resource.data.passengerId == request.auth.uid;
    }

    // Admin-managed settings (fares, commission, thresholds) and drivers
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /drivers/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
